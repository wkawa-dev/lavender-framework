{
	frankenphp
	auto_https off
	admin off
}

:8080 {
	root * /app/public
	# Compression is worth more to Lighthouse than any markup tweak: CSS goes ~46 KB → ~10 KB.
	encode zstd gzip

	# Fingerprinted or content-addressed files never change under the same URL.
	# public/images is regenerated by images:optimize; rename the source to bust.
	@immutable path /build/* /images/* /video/* /themes/* /favicon.ico
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	php_server
}
